<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<title>{{ document.title }}</title>
<style>
body{font-family:"Times New Roman","標楷體","DFKai-SB",serif;margin:2rem;color:#172033;line-height:1.65}
.cjk{font-family:"標楷體",KaiTi,"DFKai-SB",serif}.latin,.numeric{font-family:"Times New Roman",serif}.table-tech,.address,.evidence-id{font-family:Consolas,monospace}
h1,h2,h3{color:#16213e;break-after:avoid-page;page-break-after:avoid}section{margin:1.5rem 0}#cover{position:relative;min-height:90vh;display:flex;flex-direction:column;justify-content:center;text-align:center;overflow:hidden;break-after:page;page-break-after:always}#cover:before{content:"₿";position:absolute;inset:18% 0 auto;color:#eef1f5;font:15rem/1 "Segoe UI Symbol",serif;z-index:0}#cover>*{position:relative;z-index:1}#cover h1{font-size:2.7rem;margin:0 0 .5rem;letter-spacing:.04em}#cover .subtitle{font-size:1.15rem;letter-spacing:.12em;margin-bottom:5rem;color:#475569}#table_of_contents{min-height:90vh;break-after:page;page-break-after:always;text-align:center}#table_of_contents h2{font-size:2rem;margin:2rem 0 0}#table_of_contents h2:after{content:"CONTENTS";display:block;font:500 .72rem/2 "Times New Roman",serif;letter-spacing:.22em;color:#64748b}#table_of_contents .toc-grid{display:grid;grid-template-columns:1fr 1fr;gap:.35rem 3rem;text-align:left;max-width:52rem;margin:2rem auto 0;border-top:1px solid #d9dee7;padding-top:1rem}#table_of_contents p{margin:.2rem 0}section[id^="asset_analysis_"]{break-before:page;page-break-before:always}
table{border-collapse:collapse;width:100%;font-family:Consolas,"標楷體","DFKai-SB",monospace;font-size:.88rem;table-layout:auto}thead{display:table-header-group}tr{break-inside:avoid-page;page-break-inside:avoid}th,td{border:1px solid #cbd5e1;padding:.45rem;text-align:left;vertical-align:middle;overflow-wrap:anywhere;white-space:pre-line}th{white-space:nowrap;word-break:keep-all;overflow-wrap:normal;background:#f1f5f9}
#key_address_summary tbody tr{height:4.5rem}
.meta,.notice{background:#f1f5f9;padding:1rem;border-radius:.5rem}.notice{border-left:4px solid #f59e0b}
iframe{width:100%;height:720px;border:1px solid #cbd5e1}@media print{iframe{display:none}a{color:#000}p{orphans:2;widows:2}.ai-claim{break-inside:avoid-page}}
</style>
</head>
<body>
{% for section in document.sections %}
<section id="{{ section.section_id }}">{% if section.section_id == "cover" %}<h1>{{ document.title|mixed_text }}</h1><p class="subtitle">{% if document.metadata.principal_asset_coverage == "missing" %}{{ "TRX Sub-Asset Analysis and Counterparty Overview"|mixed_text }}{% else %}{{ "Address Profile and First-Hop Fund Flow Analysis"|mixed_text }}{% endif %}</p>{% else %}<h2>{{ section.title|mixed_text }}</h2>{% endif %}
{% if section.section_id == "table_of_contents" %}<div class="toc-grid">{% for block in section.content_blocks %}<p>{{ block|mixed_text }}</p>{% endfor %}</div>{% else %}{% for block in section.content_blocks %}<p>{{ block|mixed_text }}</p>{% endfor %}{% endif %}
{% for figure in section.figures %}{% if figure.path.lower().endswith(('.png', '.jpg', '.jpeg')) %}<figure><img src="{{ figure.path }}" alt="{{ figure.description }}" style="display:block;max-width:100%;height:auto;margin:1rem auto;"><figcaption>{{ figure.description|mixed_text }}</figcaption></figure>{% endif %}{% endfor %}
{% for table in section.tables %}<h3>{{ table.title|mixed_text }}</h3><table id="{{ table.table_id }}"><thead><tr>{% for column in table.columns %}<th>{{ column|mixed_table }}</th>{% endfor %}</tr></thead><tbody>{% for row in table.rows %}<tr>{% for value in row %}<td>{{ value|mixed_table }}</td>{% endfor %}</tr>{% endfor %}</tbody></table>{% endfor %}
{% if section.section_id == "graph" %}<p><a href="flow.html">開啟離線互動圖</a></p><iframe src="flow.html" title="Transaction graph"></iframe>{% endif %}
</section>
{% endfor %}
</body></html>
