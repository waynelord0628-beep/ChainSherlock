{% for section in document.sections %}
{% if section.section_id == "cover" %}
# {{ document.title }}

## {% if document.metadata.principal_asset_coverage == "missing" %}TRX Sub-Asset Analysis and Counterparty Overview{% else %}Address Profile and First-Hop Fund Flow Analysis{% endif %}

<div align="center" style="font-size:72px;color:#e5e7eb;">₿</div>

{% for block in section.content_blocks %}{{ block }}

{% endfor %}
<div style="page-break-after: always;"></div>
{% elif section.section_id == "table_of_contents" %}
## {{ section.title }}

{% for block in section.content_blocks %}{{ block }}

{% endfor %}
<div style="page-break-after: always;"></div>
{% else %}
{% if section.section_id.startswith("asset_analysis_") %}<div style="page-break-before: always;"></div>

{% endif %}
## {{ section.title }}

{% for block in section.content_blocks %}{{ block }}

{% endfor %}
{% for figure in section.figures %}
{% if figure.path.lower().endswith(('.png', '.jpg', '.jpeg')) %}
![{{ figure.description }}]({{ figure.path }})

{% endif %}
{% endfor %}
{% for table in section.tables %}
### {{ table.title }}

|{% for column in table.columns %} {{ column }} |{% endfor %}
|{% for column in table.columns %} --- |{% endfor %}
{% for row in table.rows %}
|{% for value in row %} {{ value | replace('\n', '<br>') }} |{% endfor %}
{% endfor %}

{% endfor %}
{% endif %}
{% endfor %}
